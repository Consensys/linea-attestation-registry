{
  "name": "@verax-attestation-registry/verax-sdk",
  "version": "3.0.0-beta-5",
  "description": "Verax Attestation Registry SDK to interact with the subgraph and the contracts",
  "keywords": [
    "linea-attestation-registry",
    "blockchain",
    "attestation",
    "ethereum",
    "foundry",
    "smart-contracts",
    "solidity"
  ],
  "repository": "github.com/Consensys/linea-attestation-registry",
  "license": "MIT",
  "author": "Consensys",
  "type": "commonjs",
  "main": "./lib/src/VeraxSdk.js",
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "types": "./lib/types/src/VeraxSdk.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "attestation": "ts-node examples/attestation/index.ts",
    "build": "pnpm run clean && tsc --p ./tsconfig.build.json && esbuild src/VeraxSdk.ts --bundle --platform=browser --define:process.env.NODE_ENV='\"production\"' --define:process.env.NODE_DEBUG='false' --outfile=lib/src/VeraxSdk.js --format=esm && ts-node scripts/fix-imports.ts",
    "clean": "rm -rf ./lib",
    "generate": "graphclient build",
    "module": "ts-node examples/module/index.ts",
    "prepack": "npm run build",
    "portal": "ts-node examples/portal/index.ts",
    "publish:public": "pnpm publish --access public --no-git-checks",
    "schema": "ts-node examples/schema/index.ts",
    "test": "jest",
    "test:ci": "cp .env.example .env && pnpm run test",
    "test:integration": "jest integration",
    "test:integration:ci": "cp .env.example .env && pnpm run test:integration",
    "test:unit": "jest --testPathIgnorePatterns='integration'",
    "test:unit:coverage": "pnpm run test:unit --coverage"
  },
  "dependencies": {
    "@graphprotocol/client-add-source-name": "^2.0.7",
    "@graphql-mesh/cache-localforage": "^0.105.3",
    "@graphql-mesh/cross-helpers": "^0.4.10",
    "@graphql-mesh/graphql": "^0.104.2",
    "@graphql-mesh/http": "^0.106.2",
    "@graphql-mesh/merger-bare": "^0.105.2",
    "@graphql-mesh/runtime": "^0.106.2",
    "@graphql-mesh/store": "^0.104.2",
    "@graphql-mesh/utils": "^0.104.2",
    "@graphql-yoga/plugin-persisted-operations": "^3.13.4",
    "@whatwg-node/fetch": "^0.10.5",
    "axios": "^1.12.2",
    "browserify-fs": "^1.0.0",
    "dotenv": "^16.4.7",
    "graphql": "16.10.0",
    "ipfs-http-client": "^60.0.1",
    "viem": "^2.26.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.0",
    "@graphprotocol/client-cli": "^3.0.7",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^18.16.20",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-import-meta": "^2.3.2",
    "esbuild": "^0.25.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4"
  }
}
