{
  "name": "@verax-attestation-registry/verax-contracts",
  "version": "10.0.0",
  "description": "Verax Attestation Registry core smart contracts",
  "keywords": [
    "verax",
    "blockchain",
    "attestation",
    "ethereum",
    "foundry",
    "hardhat",
    "smart-contracts",
    "solidity"
  ],
  "repository": "github.com/Consensys/linea-attestation-registry",
  "license": "MIT",
  "author": "Consensys",
  "files": [
    "contracts/**/*.sol",
    "build/*.json",
    "!contracts/examples/**/*"
  ],
  "scripts": {
    "build": "forge build",
    "check:implementations": "hardhat run script/upgrade/checkImplementations.ts",
    "check:size": "hardhat size-contracts",
    "check:upgradeability": "hardhat run script/upgrade/checkUpgradeability.ts --network",
    "clean": "rm -rf lcov.info coverage artifacts cache_forge cache_hardhat cache out typechain-types build contracts",
    "copy": "ts-node script/copyOutputs.ts",
    "deploy": "VERIFY_CONTRACTS=true hardhat run script/deploy/deployEverything.ts --network",
    "deploy:no-verify": "VERIFY_CONTRACTS=false hardhat run script/deploy/deployEverything.ts --network",
    "deploy:eas": "VERIFY_CONTRACTS=true hardhat run script/deploy/deployEas.ts --network",
    "deploy:eas:no-verify": "VERIFY_CONTRACTS=false hardhat run script/deploy/deployEas.ts --network",
    "deploy:implementations": "VERIFY_CONTRACTS=true hardhat run script/deploy/deployImplementations.ts --network",
    "deploy:implementations:no-verify": "VERIFY_CONTRACTS=false hardhat run script/deploy/deployImplementations.ts --network",
    "deploy:implementations:eas": "VERIFY_CONTRACTS=true hardhat run script/deploy/deployImplementationsEas.ts --network",
    "deploy:implementations:eas:no-verify": "VERIFY_CONTRACTS=false hardhat run script/deploy/deployImplementationsEas.ts --network",
    "deploy:issuers": "VERIFY_CONTRACTS=true hardhat run script/deploy/deployIssuers.ts --network",
    "deploy:issuers:no-verify": "VERIFY_CONTRACTS=false hardhat run script/deploy/deployIssuers.ts --network",
    "deploy:post": "hardhat run script/deploy/postDeployment.ts --network",
    "deploy:stdlib": "VERIFY_CONTRACTS=true hardhat run script/deploy/deployStdLib.ts --network",
    "deploy:stdlib:no-verify": "VERIFY_CONTRACTS=false hardhat run script/deploy/deployStdLib.ts --network",
    "lint": "pnpm solhint \"{src,test}/**/*.sol\" -c .solhint.json",
    "prepack": "./prepack.sh",
    "postpack": "./postpack.sh",
    "prepublishOnly": "pnpm run clean && pnpm run lint && pnpm run build && pnpm run test",
    "publish:dry-run": "pnpm publish --dry-run --no-git-checks",
    "publish:public": "pnpm publish --access public --no-git-checks",
    "reimport": "hardhat run script/recreateNetworkFile.ts --network",
    "test": "forge test",
    "test:coverage": "forge coverage --report lcov && genhtml lcov.info -o coverage/html",
    "upgrade": "VERIFY_CONTRACTS=true hardhat run script/upgrade/upgradeEverything.ts --network",
    "upgrade:no-verify": "VERIFY_CONTRACTS=false hardhat run script/upgrade/upgradeEverything.ts --network",
    "upgrade:eas": "VERIFY_CONTRACTS=true hardhat run script/upgrade/upgradeEas.ts --network",
    "upgrade:eas:no-verify": "VERIFY_CONTRACTS=false hardhat run script/upgrade/upgradeEas.ts --network",
    "verify": "hardhat run script/verify.ts --network"
  },
  "dependencies": {
    "@openzeppelin/contracts": "catalog:solidity",
    "@openzeppelin/contracts-upgradeable": "catalog:solidity"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-foundry": "1.2.1",
    "@nomicfoundation/hardhat-toolbox": "6.1.2",
    "@openzeppelin/hardhat-upgrades": "3.9.1",
    "@types/node": "catalog:types",
    "dotenv": "17.4.2",
    "ethers": "6.16.0",
    "hardhat": "2.28.6",
    "hardhat-contract-sizer": "2.10.1",
    "solhint": "catalog:solidity",
    "solhint-plugin-prettier": "0.1.0"
  }
}
