{
  "name": "verax-explorer",
  "version": "0.0.1",
  "description": "Verax Attestation Registry explorer",
  "keywords": [
    "linea-attestation-registry",
    "blockchain",
    "attestation",
    "ethereum",
    "foundry",
    "smart-contracts",
    "solidity"
  ],
  "repository": "github.com/Consensys/linea-attestation-registry",
  "license": "MIT",
  "author": "Consensys",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "build:netlify": "pnpm run build && pnpm run redirect",
    "dev": "vite",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "redirect": "touch dist/_redirects && echo '/*  /index.html  200' >> dist/_redirects"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-table": "^8.21.3",
    "@verax-attestation-registry/verax-sdk": "5.0.0",
    "abitype": "^0.10.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.1",
    "framer-motion": "^10.18.0",
    "i18next": "^23.7.8",
    "lucide-react": "^0.292.0",
    "moment": "^2.30.1",
    "react": "^19.0.1",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^19.0.1",
    "react-i18next": "^13.5.0",
    "react-json-view": "^1.21.3",
    "react-router-dom": "^6.30.1",
    "swr": "^2.3.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "usehooks-ts": "^2.16.0",
    "viem": "^2.38.3",
    "vite-tsconfig-paths": "^4.3.2",
    "wagmi": "^2.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "@types/react": "^18.3.26",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.5.6",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.18",
    "typescript": "5.2.2",
    "vite": "^5.4.21",
    "vite-plugin-radar": "^0.10.1",
    "vite-plugin-svgr": "^4.5.0"
  }
